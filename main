    Text    = 'Enable Auto-Roll',
    Default = false,
    Tooltip = 'Starts the stand reroll state machine',
    Callback = function(value)
        if value then
            if not State.Running then
                State.Running      = true
                State.CurrentPhase = 'IDLE'
                loopThread         = task.spawn(runLoop)
            end
        else
            State.Running = false
            if loopThread then
                pcall(task.cancel, loopThread)
                loopThread = nil
            end
            State.CurrentPhase = 'IDLE'
        end
    end,
})

