-- ── Locate Menu Button with Cursor ───────────────────────────────────────────
local function findMenuButton()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)

    -- 1. Search by location in bottom-right corner (YBA golden menu button at bottom right)
    local bestBtn = nil
    local maxScore = -1
    local hud = PlayerGui:FindFirstChild("HUD")
    local searchRoots = { hud, PlayerGui }

    for _, root in ipairs(searchRoots) do
        if root then
            for _, v in ipairs(root:GetDescendants()) do
                if v:IsA("GuiButton") and v.Visible then
                    local sg = v:FindFirstAncestorOfClass("ScreenGui")
                    local sgName = sg and sg.Name:lower() or ""
                    if not sgName:find("obsidian") and not sgName:find("library") and not sgName:find("scythe") then
                        local pos = v.AbsolutePosition
                        local sz = v.AbsoluteSize
                        if pos.X > vp.X * 0.75 and pos.Y > vp.Y * 0.75 and sz.X >= 18 and sz.Y >= 18 and sz.X <= 180 and sz.Y <= 180 then
                            local score = pos.X + pos.Y
                            if score > maxScore then
                                maxScore = score
                                bestBtn = v
                            end
                        end
                    end
                end
            end
            if bestBtn then return bestBtn end
        end
    end

    -- 2. By name / text
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v:IsA("GuiButton") and v.Visible then
            local n = v.Name:lower()
            local t = (v.Text or ""):lower()
            if n == "menu" or t == "menu" or n == "меню" or t == "меню"
               or n:find("menubutton") or n:find("openmenu") or n:find("togglemenu") then
                return v
            end
        end
    end

    return nil
end

-- ── Game Remote Access Helper ────────────────────────────────────────────────
local function getGameRemote()
    local char = LocalPlayer.Character
    local re = (char and char:FindFirstChild("RemoteEvent"))
        or game:GetService("ReplicatedStorage"):FindFirstChild("RemoteEvent", true)
    local rf = (char and char:FindFirstChild("RemoteFunction"))
        or game:GetService("ReplicatedStorage"):FindFirstChild("RemoteFunction", true)
    return re, rf
end

-- ── Smart Item Equipper (Headless Backpack -> Character) ───────────────────────
local function smartEquipItem(itemName)
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end

    -- 1. Check if tool is ALREADY in hand
    local inHand = char:FindFirstChildOfClass("Tool")
    if inHand and itemMatches(inHand.Name, itemName) and not inHand.Name:lower():find("использован") and not inHand.Name:lower():find("used") then
        return inHand
    end

    -- 2. Direct equip from LocalPlayer.Backpack via Humanoid:EquipTool() (Headless)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and itemMatches(tool.Name, itemName) and not tool.Name:lower():find("использован") and not tool.Name:lower():find("used") then
                pcall(function()
                    hum:EquipTool(tool)
                end)
                for _ = 1, 10 do
                    task.wait(0.05)
                    local eq = char:FindFirstChildOfClass("Tool")
                    if eq and itemMatches(eq.Name, itemName) then
                        return eq
                    end
                end
                -- Fallback parenting if EquipTool was delayed
                if tool.Parent == bp then
                    pcall(function() tool.Parent = char end)
                    task.wait(0.1)
                end
                local eq = char:FindFirstChildOfClass("Tool")
                if eq and itemMatches(eq.Name, itemName) then
                    return eq
                end
            end
        end
    end

    -- Final verify
    local eqNow = char:FindFirstChildOfClass("Tool")
    if eqNow and itemMatches(eqNow.Name, itemName) then
        return eqNow
    end

    return nil
end


local function equipTool(substring)
    return smartEquipItem(substring)
end
-- ── 5A · Worthiness unlock (Agility I-III -> Pause 0.5s -> Worthiness Retry Loop) ─
local function unlockWorthiness()
    State.CurrentPhase = "UNLOCKING_WORTHINESS"
    pcall(function() Library:Notify("Прокачка Достоинства (Agility I-III -> Worthiness)...", 3) end)

    local re, rf = getGameRemote()

    -- 1. Последовательная прокачка 3 уровней скорости (Agility I, II, III)
    local agilityChain = {
        { "Agility I", "Agility 1", "Ловкость I", "Ловкость 1" },
        { "Agility II", "Agility 2", "Ловкость II", "Ловкость 2" },
        { "Agility III", "Agility 3", "Ловкость III", "Ловкость 3" },
    }

    for i, aliases in ipairs(agilityChain) do
        local curRe, curRf = getGameRemote()
        local activeRe = curRe or re
        local activeRf = curRf or rf

        for _, skillName in ipairs(aliases) do
            if activeRf then
                pcall(function()
                    activeRf:InvokeServer("LearnSkill", {
                        ["Skill"] = skillName,
                        ["SkillTreeType"] = "Character",
                    })
                end)
            end
            if activeRe then
                pcall(function()
                    activeRe:FireServer("LearnSkill", {
                        ["Skill"] = skillName,
                        ["SkillTreeType"] = "Character",
                    })
                end)
            end
        end

        -- Пауза 0.3 сек между 1-м и 2-м уровнями скорости
        if i < 3 then
            task.wait(0.3)
        end
    end

    -- 1. ПАУЗА ПОСЛЕ 3-Й СКОРОСТИ:
    -- Серверу игры требуется время, чтобы зафиксировать регистрацию покупки Agility III
    task.wait(0.5)

    -- 2. ПЕРЕБОР ВСЕХ ВОЗМОЖНЫХ ИДЕНТИФИКАТОРОВ ДОСТОИНСТВА:
    local worthinessVariants = {
        "Worthiness",
        "Worthiness I",
        "Worthiness 1",
        "Worthiness1",
        "Достоинство",
        "Достоинство I",
        "Достоинство 1",
        "Character_Worthiness",
        "CharacterWorthiness",
    }

    -- 3. ПОВТОРНАЯ ПОПЫТКА (RETRY LOOP: 3 попытки с интервалом 0.4 сек):
    for attempt = 1, 3 do
        local curRe, curRf = getGameRemote()
        local activeRe = curRe or re
        local activeRf = curRf or rf

        for _, variant in ipairs(worthinessVariants) do
            if activeRf then
                pcall(function()
                    activeRf:InvokeServer("LearnSkill", {
                        ["Skill"] = variant,
                        ["SkillTreeType"] = "Character",
                    })
                end)
            end
            if activeRe then
                pcall(function()
                    activeRe:FireServer("LearnSkill", {
                        ["Skill"] = variant,
                        ["SkillTreeType"] = "Character",
                    })
                end)
            end
            -- Задержка task.wait(0.15) между вариантами с защитой pcall
            task.wait(0.15)
        end

        if attempt < 3 then
            task.wait(0.4)
        end
    end

    State.Worthiness = "LEARNED"
    task.wait(0.2)
end

-- ── 5B · Map Scavenger ────────────────────────────────────────────────────────
local function scavengeMap(missingItem, missingRoka)
    State.CurrentPhase = "SCAVENGING"
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    local startTime  = tick()
    local searchNames = {}
    if missingItem then table.insert(searchNames, Config.ItemType) end
    if missingRoka  then table.insert(searchNames, "Rokakaka") end

    while tick() - startTime < Config.ScavengeTimeout do
        for _, name in ipairs(searchNames) do
            local low = name:lower()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj.Name:lower():find(low, 1, true) then
                    local pos = nil
                    if obj:IsA("BasePart") then
                        pos = obj.Position
                    elseif obj:IsA("Model") and obj.PrimaryPart then
                        pos = obj.PrimaryPart.Position
                    end
                    if pos and (hrp.Position - pos).Magnitude < 200 then
                        hum:MoveTo(pos)
                        local ms = tick()
                        repeat task.wait(0.1)
                        until (hrp.Position - pos).Magnitude < 6 or tick() - ms > 5

                        local pp = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if pp then pcall(function() fireclickdetector(pp) end) end
                        task.wait(0.4)

                        local ni = countInBackpack(Config.ItemType)
                        local nr = countInBackpack("Rokakaka")
                        State.ItemCount = ni
                        State.RokaCount = nr
                        if ni > 0 and nr > 0 then return true end
                    end
                end
            end
        end
        task.wait(0.5)
    end
    return false
end

-- ── 5C · Shop Auto-Buyer ──────────────────────────────────────────────────────
local function buyFromShop(needItem, needRoka)
    State.CurrentPhase = "BUYING"

    local menuBtn = findMenuButton()
    if menuBtn then
        clickWithCursor(menuBtn)
        task.wait(Config.ShopDelay)
    end

    local shopBtn = nil
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v:IsA("GuiButton") and v.Visible then
            local txt = v.Text or ""
            if txt:find("%$") or txt:lower():find("shop") then
                shopBtn = v ; break
            end
        end
    end
    if shopBtn then
        clickWithCursor(shopBtn)
        task.wait(Config.ShopDelay * 1.5)
    end

    local function purchaseItem(keyword)
        local targets = { "5x " .. keyword, "1x " .. keyword, keyword }
        for _, target in ipairs(targets) do
            local low = target:lower()
            for _, v in ipairs(PlayerGui:GetDescendants()) do
                if v:IsA("TextLabel") and v.Text:lower():find(low, 1, true) then
                    local parent = v.Parent
                    while parent and parent ~= PlayerGui do
                        for _, child in ipairs(parent:GetDescendants()) do
                            if child:IsA("TextButton") then
                                local ct = child.Text:lower()
                                if ct:find("buy") or ct:find("купить") or ct:find("purchase") then
                                    clickWithCursor(child)
                                    task.wait(Config.ShopDelay)
                                    local confirmBtn = findDescendantContaining(PlayerGui, "Confirm")
                                        or findDescendantContaining(PlayerGui, "Yes")
                                        or findDescendantContaining(PlayerGui, "Да")
                                    if confirmBtn and confirmBtn:IsA("GuiButton") then
                                        clickWithCursor(confirmBtn)
                                        task.wait(Config.ShopDelay)
                                    end
                                    return true
                                end
                            end
                        end
                        parent = parent.Parent
                    end
                end
            end
        end
        return false
    end

    if needItem then
        if Config.ItemType:lower():find("rib cage", 1, true) then
            purchaseItem("Rib Cage of the Saint's Corpse")
        else
            purchaseItem(Config.ItemType)
        end
    end
    task.wait(Config.ShopDelay)
    if needRoka then purchaseItem("Rokakaka") end
    task.wait(Config.ShopDelay)

    local closeShop = findDescendantContaining(PlayerGui, "Close")
        or findDescendantContaining(PlayerGui, "Закрыть")
    if closeShop and closeShop:IsA("GuiButton") then
        clickWithCursor(closeShop)
    end
    task.wait(Config.ShopDelay)

    State.ItemCount = countInBackpack(Config.ItemType)
    State.RokaCount = countInBackpack("Rokakaka")
end

-- ── 5D · Dialogue Helper & Confirmer ─────────────────────────────────────────
local AFFIRMATIVE_TERMS = {
    -- Russian
    "да", "съесть", "сьесть", "использовать", "применить", "принять",
    "покушать", "скушать", "подтвердить", "хорошо", "ок", "вперед",
    -- English
    "yes", "eat", "use", "confirm", "accept", "sure", "ok"
}

local NEGATIVE_TERMS = {
    -- Russian
    "нет", "отмена", "не надо", "не хочу", "отказаться", "закрыть", "уйти", "отклонить",
    -- English
    "no", "cancel", "decline", "refuse", "close", "leave", "don't"
}

local function isAffirmativeDialogueWord(str)
    if not str or type(str) ~= "string" or str == "" then return false end
    local lower = toLowerUtf8(str)
    local clean = lower:gsub("[%p%s]+", "")

    for _, neg in ipairs(NEGATIVE_TERMS) do
        if clean == neg or lower:find(neg, 1, true) then
            return false
        end
    end

    for _, aff in ipairs(AFFIRMATIVE_TERMS) do
        if clean == aff or lower:find(aff, 1, true) then
            return true
        end
    end
    return false
end

local function isNegativeDialogueWord(str)
    if not str or type(str) ~= "string" or str == "" then return false end
    local lower = toLowerUtf8(str)
    local clean = lower:gsub("[%p%s]+", "")
    for _, neg in ipairs(NEGATIVE_TERMS) do
        if clean == neg or lower:find(neg, 1, true) then
            return true
        end
    end
    return false
end

local function getGuiFullText(guiObj)
    if not guiObj then return "" end
    local parts = {}
    if (guiObj:IsA("TextButton") or guiObj:IsA("TextLabel")) and guiObj.Text and guiObj.Text ~= "" then
        table.insert(parts, guiObj.Text)
    end
    for _, ch in ipairs(guiObj:GetDescendants()) do
        if (ch:IsA("TextLabel") or ch:IsA("TextButton")) and ch.Text and ch.Text ~= "" then
            table.insert(parts, ch.Text)
        end
    end
    return table.concat(parts, " ")
end

local function isEffectivelyVisible(guiObj)
    if not guiObj or not guiObj:IsA("GuiObject") then return false end
    if not guiObj.Visible then return false end
    local sz = guiObj.AbsoluteSize
    if sz.X <= 5 or sz.Y <= 5 then return false end

    local current = guiObj.Parent
    while current and current:IsA("GuiObject") do
        if not current.Visible then return false end
        current = current.Parent
    end

    local sg = guiObj:FindFirstAncestorOfClass("ScreenGui")
    if not sg or not sg.Enabled then return false end

    return true
end

local function isDialogueButtonAffirmative(v)
    if not v or not v:IsA("GuiObject") then return false end

    -- Элемент и все его родительские фреймы должны быть реально видимы на экране
    if not isEffectivelyVisible(v) then
        return false
    end

    -- Ignore Scythe / Obsidian / Library GUI
    local sg = v:FindFirstAncestorOfClass("ScreenGui")
    local sgName = sg and sg.Name:lower() or ""
    if sgName:find("obsidian") or sgName:find("library") or sgName:find("scythe") then
        return false
    end

    -- Ignore Player list / Leaderboard / Chat
    local p = v.Parent
    while p and p ~= PlayerGui do
        local pn = p.Name:lower()
        if pn:find("leaderboard") or pn:find("playerlist") or pn:find("player_list") or pn:find("chat") then
            return false
        end
        p = p.Parent
    end

    local name = toLowerUtf8(v.Name):gsub("[%p%s]+", "")

    -- Direct negative button name
    if name == "option2" or name == "choice2" or name == "button2" or name == "btn2" or name == "2"
       or name == "no" or name == "cancel" or name == "нет" or name == "отмена" then
        return false
    end

    local fullText = getGuiFullText(v)
    if isNegativeDialogueWord(fullText) then
        return false
    end

    if isAffirmativeDialogueWord(fullText) then
        return true
    end

    -- Check button name
    if name == "option1" or name == "choice1" or name == "button1" or name == "btn1" or name == "1"
       or name == "option" or name == "choice"
       or name == "yes" or name == "eat" or name == "use" or name == "confirm"
       or name == "да" or name == "съесть" or name == "сьесть" or name == "использовать" then
        return true
    end

    return false
end

-- ── 5D · Direct GUI Engine Dialogue Button Activation (Ultrawide-Safe) ────────
local function activateDialogueButton(targetButton)
    if not targetButton or not targetButton:IsA("GuiObject") then return false end
    local activated = false

    -- 1. Системный фокус движка Roblox (GuiService.SelectedObject) + виртуальный ввод клавиши Return
    pcall(function()
        local guiService = game:GetService("GuiService")
        local vim = game:GetService("VirtualInputManager")
        if guiService then
            guiService.SelectedObject = targetButton
            task.wait(0.05)
            if vim then
                vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                task.wait(0.03)
                vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
            end
            guiService.SelectedObject = nil
            activated = true
        end
    end)

    -- 2. Прямой программный вызов событий объекта кнопки через firesignal
    if firesignal then
        pcall(function() firesignal(targetButton.Activated) end)
        pcall(function() firesignal(targetButton.MouseButton1Click) end)
        pcall(function() firesignal(targetButton.MouseButton1Down) end)
        pcall(function() firesignal(targetButton.MouseButton1Up) end)
        activated = true
    end

    -- 3. Встроенный метод эксплоита FireMouseButton1Click (если поддерживается средой)
    pcall(function()
        if targetButton.FireMouseButton1Click then
            targetButton:FireMouseButton1Click()
            activated = true
        end
    end)

    -- 4. Альтернативный расчет через нижнюю часть объекта со смещением вниз (Fallback VIM)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim then
            local pos = targetButton.AbsolutePosition
            local size = targetButton.AbsoluteSize
            local cx = pos.X + (size.X / 2)

            -- Смещаем точку клика значительно ниже центра по оси Y в нижнюю половину объекта:
            -- Верхний край кнопки (pos.Y) + вся высота (size.Y) минус 5-7 пикселей,
            -- либо к центру + 15..20 пикселей вниз, чтобы гарантированно избежать промаха выше кнопки на Ultrawide
            local cy = pos.Y + size.Y - 6
            if (cy - (pos.Y + size.Y / 2)) < 15 then
                cy = pos.Y + (size.Y / 2) + 16
            end

            local sg = targetButton:FindFirstAncestorOfClass("ScreenGui")
            local guiService = game:GetService("GuiService")
            if sg and not sg.IgnoreGuiInset and guiService then
                local inset = guiService:GetGuiInset()
                cy = cy + inset.Y
                cx = cx + inset.X
            end

            if cx > 0 and cy > 0 then
                vim:SendMouseMoveEvent(cx, cy, game)
                task.wait(0.03)
                vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                task.wait(0.03)
                vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                activated = true
            end
        end
    end)

    -- 5. Дополнительный fallback через VirtualUser со смещением вниз
    pcall(function()
        local vu = game:GetService("VirtualUser")
        if vu then
            local pos = targetButton.AbsolutePosition
            local size = targetButton.AbsoluteSize
            local cx = pos.X + (size.X / 2)

            local cy = pos.Y + size.Y - 6
            if (cy - (pos.Y + size.Y / 2)) < 15 then
                cy = pos.Y + (size.Y / 2) + 16
            end

            local sg = targetButton:FindFirstAncestorOfClass("ScreenGui")
            local guiService = game:GetService("GuiService")
            if sg and not sg.IgnoreGuiInset and guiService then
                local inset = guiService:GetGuiInset()
                cy = cy + inset.Y
                cx = cx + inset.X
            end

            if cx > 0 and cy > 0 then
                vu:CaptureController()
                vu:MouseMove(Vector2.new(cx, cy))
                vu:Button1Down(Vector2.new(cx, cy))
                task.wait(0.02)
                vu:Button1Up(Vector2.new(cx, cy))
                activated = true
            end
        end
    end)

    return activated
end

-- Backward compatibility aliases
local clickDialogueButtonVIM = activateDialogueButton
local triggerDialogueButton = activateDialogueButton

local function findDialogueOption()
    -- 1. Look inside known YBA dialogue containers in PlayerGui
    local knownContainers = {
        PlayerGui:FindFirstChild("Dialogue"),
        PlayerGui:FindFirstChild("DialogueGui"),
        PlayerGui:FindFirstChild("Prompt"),
        PlayerGui:FindFirstChild("ItemDialogue"),
        PlayerGui:FindFirstChild("Talk"),
        PlayerGui:FindFirstChild("HUD"),
    }

    for _, container in ipairs(knownContainers) do
        if container then
            for _, v in ipairs(container:GetDescendants()) do
                if (v:IsA("GuiButton") or v:IsA("TextButton") or v:IsA("ImageButton")) and isEffectivelyVisible(v) then
                    local nameLow = v.Name:lower():gsub("[%p%s]+", "")
                    if nameLow == "option1" or nameLow == "choice1" or nameLow == "button1" or nameLow == "btn1" then
                        return v
                    end
                    if isDialogueButtonAffirmative(v) then
                        return v
                    end
                end
            end
        end
    end

    -- 2. General search across all ScreenGuis in PlayerGui
    for _, sg in ipairs(PlayerGui:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled then
            local sgLow = sg.Name:lower()
            if not sgLow:find("obsidian") and not sgLow:find("library") and not sgLow:find("scythe") then
                for _, v in ipairs(sg:GetDescendants()) do
                    if (v:IsA("GuiButton") or v:IsA("TextButton") or v:IsA("ImageButton")) and isEffectivelyVisible(v) then
                        local nameLow = v.Name:lower():gsub("[%p%s]+", "")
                        if nameLow == "option1" or nameLow == "choice1" or nameLow == "button1" or nameLow == "btn1" then
                            return v
                        end
                        if isDialogueButtonAffirmative(v) then
                            return v
                        end
                    end
                end
            end
        end
    end

    -- 3. Fallback search across all PlayerGui
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if (v:IsA("GuiButton") or v:IsA("TextButton") or v:IsA("ImageButton")) and isEffectivelyVisible(v) then
            local sz = v.AbsoluteSize
            if sz.X > 15 and sz.Y > 10 and isDialogueButtonAffirmative(v) then
                return v
            end
        end
    end

    return nil
end

local function fireDialogueRemotes(toolName)
    local re = getGameRemote()
    if not re then return end

    local npcs = { "Item", "Rokakaka", "Mysterious Arrow" }
    if toolName then
        table.insert(npcs, 1, toolName)
        local low = tostring(toolName):lower()
        if low:find("roka") then
            table.insert(npcs, 2, "Rokakaka")
            table.insert(npcs, "Pure Rokakaka")
        elseif low:find("arrow") then
            table.insert(npcs, 2, "Mysterious Arrow")
            table.insert(npcs, "Lucky Arrow")
        elseif low:find("rib") then
            table.insert(npcs, 2, "Rib Cage of the Saint's Corpse")
            table.insert(npcs, "Rib Cage")
        end
    end

    for _, npcName in ipairs(npcs) do
        pcall(function()
            re:FireServer("EndDialogue", {
                ["NPC"] = npcName,
                ["Option"] = "Option1",
                ["Dialogue"] = "Dialogue1",
            })
        end)
    end
end

-- ── Dialogue Confirmation (Direct GUI Engine Activation + RemoteEvent) ────────
local function confirmDialogue(toolName)
    local targetButton = findDialogueOption()
    local activated = false
    if targetButton then
        activated = activateDialogueButton(targetButton)
    end
    fireDialogueRemotes(toolName)
    return activated or (targetButton ~= nil)
end

-- ── Headless Item Usage (Equip -> Activate -> GUI Object Activation Loop) ─────
local function useItemHeadless(itemName)
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- 1. Экипировать предмет в руки напрямую из Backpack
    local tool = smartEquipItem(itemName)
    if not tool then
        return false
    end
    task.wait(0.15)

    local inHand = char:FindFirstChildOfClass("Tool")
    if not inHand or not itemMatches(inHand.Name, itemName) then
        inHand = tool
    end

    -- 2. Первичная активация предмета
    if inHand then
        pcall(function() inHand:Activate() end)
    end

    -- 3. Цикл подтверждения диалога (попытки каждые 0.25–0.3 сек, общий таймаут 3.5–4.0 сек)
    local initialChar = char
    local startTime = tick()
    local lastActivate = tick()
    local buttonFoundOnce = false

    while tick() - startTime < 4.0 do
        -- Проверка начала сброса: смерть / респавн персонажа (Rokakaka)
        local curChar = LocalPlayer.Character
        local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
        if curChar ~= initialChar or not curHum or curHum.Health <= 0 then
            return true
        end

        -- Проверка исчезновения предмета из руки (предмет был успешно съеден / применен)
        local curTool = curChar:FindFirstChildOfClass("Tool")
        if not curTool or not itemMatches(curTool.Name, itemName) then
            return true
        end

        -- 1. Динамический поиск объекта активной кнопки подтверждения в интерфейсе
        local targetButton = findDialogueOption()

        if targetButton then
            buttonFoundOnce = true

            -- 2. Активация кнопки напрямую через GUI Engine (SelectedObject, firesignal, FireMouseButton1Click + Fallback)
            activateDialogueButton(targetButton)

            -- в) Сетевой вызов для дублирования: отправка RemoteEvent EndDialogue
            fireDialogueRemotes(curTool and curTool.Name or itemName)

            -- Интервал между попытками активации: 0.25–0.3 секунды
            task.wait(0.25)
        else
            -- Если кнопка уже появлялась и была нажата, а теперь исчезла из интерфейса:
            if buttonFoundOnce then
                task.wait(0.2)
                local endTool = curChar:FindFirstChildOfClass("Tool")
                if not endTool or not itemMatches(endTool.Name, itemName) then
                    return true
                end
            end

            -- Если диалог еще не появился через 0.4 сек, повторно активируем тул
            if tick() - lastActivate > 0.4 and curTool then
                pcall(function() curTool:Activate() end)
                lastActivate = tick()
            end

            task.wait(0.08)
        end
    end

    -- Финальная проверка: исчез ли предмет из рук
    local endChar = LocalPlayer.Character
    local endTool = endChar and endChar:FindFirstChildOfClass("Tool")
    if not endTool or not itemMatches(endTool.Name, itemName) then
        return true
    end

    return false
end

-- Backward compatibility alias
local useItemWithCursor = useItemHeadless


-- ── 5E · Stand Detection ──────────────────────────────────────────────────────
local function detectCurrentStand()
    -- 1. Check PlayerStats (Official YBA data container)
    local pStats = LocalPlayer:FindFirstChild("PlayerStats")
    if pStats then
        local sVal = pStats:FindFirstChild("Stand")
        if sVal and sVal:IsA("StringValue") then
            local val = sVal.Value
            if val and val ~= "" and val ~= "None" and val ~= "Standless" and val ~= "nil" then
                for _, s in ipairs(Config.StandPool) do
                    if val:lower() == s:lower() then
                        return s
                    end
                end
                return val
            else
                -- Authoritative: player has no stand!
                return "None"
            end
        end
    end

    -- 2. Check Attributes on Character or Player
    local attrStand = LocalPlayer:GetAttribute("Stand") or (LocalPlayer.Character and LocalPlayer.Character:GetAttribute("Stand"))
    if attrStand and type(attrStand) == "string" and attrStand ~= "" and attrStand ~= "None" and attrStand ~= "Standless" then
        for _, s in ipairs(Config.StandPool) do
            if attrStand:lower() == s:lower() then
                return s
            end
        end
    end

    -- 3. Check for Stand Model inside Character (excluding character body parts)
    local char = LocalPlayer.Character
    if char then
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Model") and obj.Name ~= char.Name and not obj:FindFirstChildOfClass("Humanoid") then
                for _, s in ipairs(Config.StandPool) do
                    if obj.Name:lower() == s:lower() then
                        return s
                    end
                end
            end
        end
    end

    -- 4. Check HUD Stand Label (STRICT: only inside PlayerGui.HUD, never Cheat UI!)
    local hud = PlayerGui:FindFirstChild("HUD")
    if hud then
        for _, v in ipairs(hud:GetDescendants()) do
            if v:IsA("TextLabel") and v.Visible then
                local sg = v:FindFirstAncestorOfClass("ScreenGui")
                local sgName = sg and sg.Name:lower() or ""
                if not sgName:find("obsidian") and not sgName:find("library") and not sgName:find("scythe") then
                    local pName = v.Parent and v.Parent.Name:lower() or ""
                    if not pName:find("player") and not pName:find("list") and not pName:find("board") then
                        local t = v.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
                        for _, s in ipairs(Config.StandPool) do
                            if t == s:lower() then
                                return s
                            end
                        end
                    end
                end
            end
        end
    end

    return "None"
end

-- ── 5E-2 · Prominent On-Screen Stand Display Banner ──────────────────────────
local standBannerGui = nil

local function showStandBanner(standName, targetStand, isTarget)
    pcall(function()
        local parentGui = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
            or LocalPlayer:FindFirstChild("PlayerGui")
            or game:GetService("CoreGui")

        if not standBannerGui or not standBannerGui.Parent then
            standBannerGui = Instance.new("ScreenGui")
            standBannerGui.Name = "Scythe_StandBannerGui"
            standBannerGui.ResetOnSpawn = false
            standBannerGui.DisplayOrder = 999999
            standBannerGui.Parent = parentGui
        end

        local old = standBannerGui:FindFirstChild("BannerFrame")
        if old then old:Destroy() end

        local frame = Instance.new("Frame")
        frame.Name = "BannerFrame"
        frame.Size = UDim2.new(0, 500, 0, 115)
        frame.Position = UDim2.new(0.5, -250, 0, 45)
        frame.BackgroundColor3 = isTarget and Color3.fromRGB(15, 42, 22) or Color3.fromRGB(22, 22, 34)
        frame.BackgroundTransparency = 0.08
        frame.BorderSizePixel = 0
        frame.Parent = standBannerGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Color = isTarget and Color3.fromRGB(50, 255, 120) or Color3.fromRGB(190, 110, 255)
        stroke.Parent = frame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, 0, 0, 24)
        title.Position = UDim2.new(0, 0, 0, 8)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBold
        title.TextSize = 13
        title.TextColor3 = isTarget and Color3.fromRGB(100, 255, 160) or Color3.fromRGB(190, 190, 230)
        title.Text = isTarget and "★ ЦЕЛЕВОЙ СТЕНД ВЫБИТ! ★" or "SCYTHE | СТЕНД ФАРМ"
        title.Parent = frame

        local standLabel = Instance.new("TextLabel")
        standLabel.Size = UDim2.new(1, -20, 0, 44)
        standLabel.Position = UDim2.new(0, 10, 0, 32)
        standLabel.BackgroundTransparency = 1
        standLabel.Font = Enum.Font.GothamBlack
        standLabel.TextSize = 26
        standLabel.TextColor3 = isTarget and Color3.fromRGB(255, 225, 60) or Color3.fromRGB(255, 255, 255)
        standLabel.Text = "ВЫПАЛ СТЕНД: " .. tostring(standName)
        standLabel.TextScaled = true
        standLabel.Parent = frame

        local subLabel = Instance.new("TextLabel")
        subLabel.Size = UDim2.new(1, 0, 0, 22)
        subLabel.Position = UDim2.new(0, 0, 0, 80)
        subLabel.BackgroundTransparency = 1
        subLabel.Font = Enum.Font.GothamMedium
        subLabel.TextSize = 14
        subLabel.TextColor3 = isTarget and Color3.fromRGB(200, 255, 200) or Color3.fromRGB(200, 200, 230)
        subLabel.Text = isTarget and "Фарм успешно завершен!" or ("Нужен: " .. tostring(targetStand))
        subLabel.Parent = frame

        task.spawn(function()
            local myFrame = frame
            task.wait(isTarget and 15 or 6.5)
            if myFrame and myFrame.Parent then
                myFrame:Destroy()
            end
        end)
    end)
end

-- ── 5F · Reroll Loop (Headless Auto-Roll) ────────────────────────────────────
local function runLoop()
    while State.Running do
        waitAlive()

        -- 1. Check current stand right at start of iteration
        local currentStand = detectCurrentStand()
        State.ActiveStand  = currentStand

        if currentStand ~= "None" and currentStand ~= "Standless" and currentStand ~= "" then
            local isMatch = currentStand:lower():find(Config.TargetStand:lower(), 1, true) ~= nil
            if isMatch then
                showStandBanner(currentStand, Config.TargetStand, true)
                State.CurrentPhase = "FINISHED"
                State.Running      = false

                pcall(function()
                    Library:Notify("Целевой стенд уже получен: " .. currentStand, 10)
                end)
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title    = "Scythe | YBA",
                        Text     = "Целевой стенд уже получен: " .. currentStand,
                        Duration = 10,
                    })
                end)
                pcall(function()
                    if Toggles and Toggles.AutoRollToggle then
                        Toggles.AutoRollToggle:SetValue(false)
                    end
                end)
                return
            end
        end

        -- 2. Reset stand with Rokakaka (Headless)
        local hasStand = (currentStand ~= "None" and currentStand ~= "Standless" and currentStand ~= "")
        local toolInHand = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        local holdingRoka = toolInHand and itemMatches(toolInHand.Name, "Rokakaka")

        if hasStand or holdingRoka then
            State.CurrentPhase = "RESETTING"
            pcall(function()
                Library:Notify("Использование Рокакаки (сброс)...", 3)
            end)

            local eaten = false
            local rokaTries = 0

            while State.Running and not eaten and rokaTries < 4 do
                rokaTries = rokaTries + 1
                local initialChar = LocalPlayer.Character
                local ok = useItemHeadless("Rokakaka")
                if ok then
                    local t0 = tick()
                    while tick() - t0 < 3.5 do
                        local c = LocalPlayer.Character
                        local h = c and c:FindFirstChildOfClass("Humanoid")
                        if c ~= initialChar or not h or h.Health <= 0 then
                            eaten = true
                            break
                        end
                        local curS = detectCurrentStand()
                        if curS == "None" or curS == "Standless" or curS == "" then
                            eaten = true
                            break
                        end
                        task.wait(0.2)
                    end
                end
                if eaten then break end
                task.wait(0.4)
            end

            -- Ensure character is fully alive and respawned after Rokakaka
            waitAlive()
            task.wait(0.8)
        end

        if not State.Running then break end

        -- 3. Background Worthiness Upgrade (Headless, no GUI)
        State.CurrentPhase = "UNLOCKING_WORTHINESS"
        pcall(unlockWorthiness)
        task.wait(0.3)
        waitAlive()

        if not State.Running then break end

        -- 4. Use Rolling Item Headless (Arrow / Rib)
        State.CurrentPhase = "ROLLING"
        pcall(function()
            Library:Notify("Использование " .. tostring(Config.ItemType) .. "...", 3)
        end)

        local arrowUsed = false
        local arrowTries = 0
        while State.Running and not arrowUsed and arrowTries < 3 do
            arrowTries = arrowTries + 1
            local itemOk = useItemHeadless(Config.ItemType)
            if itemOk then
                arrowUsed = true
                break
            else
                task.wait(0.5)
            end
        end

        -- Wait for stand animation and spawn
        task.wait(3.5)
        waitAlive()

        if not State.Running then break end

        -- 5. Stand Detection & Target Check
        State.CurrentPhase = "DETECTING_STAND"
        local detectStart = tick()
        local newStand    = "None"
        repeat
            task.wait(0.4)
            newStand = detectCurrentStand()
        until (newStand ~= "None" and newStand ~= "Standless") or tick() - detectStart > 7

        State.ActiveStand = newStand
        local isTarget = newStand ~= "None" and newStand ~= "Standless" and (newStand:lower():find(Config.TargetStand:lower(), 1, true) ~= nil)

        -- Write on screen which stand dropped
        showStandBanner(newStand, Config.TargetStand, isTarget)

        if isTarget then
            State.CurrentPhase = "FINISHED"
            State.Running      = false

            pcall(function()
                Library:Notify("Целевой стенд успешно получен: " .. newStand, 10)
            end)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title    = "Scythe | YBA",
                    Text     = "Целевой стенд успешно получен: " .. newStand,
                    Duration = 10,
                })
            end)
            pcall(function()
                if Toggles and Toggles.AutoRollToggle then
                    Toggles.AutoRollToggle:SetValue(false)
                end
            end)
            return
        else
            pcall(function()
                Library:Notify("Выпал стенд: " .. newStand .. " (Нужен: " .. Config.TargetStand .. ")", 3)
            end)
        end

        task.wait(Config.LoopDelay or 0.5)
    end

    State.CurrentPhase = "IDLE"
end

-- ─────────────────────────────────────────────────────────────────────────────
-- § 6 · FARM ENGINE
-- ─────────────────────────────────────────────────────────────────────────────

local function isWanted(name)
    if Config.FarmItems[name] == true then return true, name end
    local low = name:lower()
    for key, enabled in pairs(Config.FarmItems) do
        if enabled and low:find(key:lower(), 1, true) then return true, key end
    end
    return false, nil
end

local function getItemPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
    end
    return nil
end

local function triggerPrompt(prompt)
    if fireproximityprompt then
        pcall(fireproximityprompt, prompt, prompt.HoldDuration or 1)
        return
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait((prompt.HoldDuration or 0) + 0.1)
        prompt:InputHoldEnd()
    end)
end

local function buildItemQueue()
    local queue = {}
    local now   = tick()
    local function scanContainer(container)
        if not container then return end
        for _, obj in ipairs(container:GetDescendants()) do
            if FarmState.Blacklist[obj] and FarmState.Blacklist[obj] > now then continue end
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local wanted, matchedKey = isWanted(obj.Name)
                if wanted then
                    local part = getItemPart(obj)
                    if part then
                        table.insert(queue, { obj = obj, part = part, key = matchedKey })
                    end
                end
            end
        end
    end
    scanContainer(workspace)
    pcall(scanContainer, workspace:FindFirstChild("ItemSpawns"))
    pcall(scanContainer, workspace:FindFirstChild("Debris"))
    pcall(scanContainer, workspace:FindFirstChild("DroppedItems"))
    return queue
end

local function pickupItem(entry)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not entry.part or not entry.part.Parent then return false end

    FarmState.Status   = "TELEPORTING"
    FarmState.LastItem = entry.key

    pcall(function()
        hrp.CFrame = entry.part.CFrame + Vector3.new(0, 2, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
    task.wait(0.15)

    local prompt = entry.obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then triggerPrompt(prompt) end
    task.wait(0.3)

    if entry.part and entry.part.Parent then
        if prompt then triggerPrompt(prompt) end
        task.wait(0.3)
        if entry.part and entry.part.Parent then
            FarmState.Blacklist[entry.obj] = tick() + 30
            return false
        end
    end

    FarmState.Tally[entry.key] = (FarmState.Tally[entry.key] or 0) + 1
    return true
end

local patrolActive       = false
local patrolDescListener = nil

local function stopPatrol()
    patrolActive = false
    if patrolDescListener then
        pcall(function() patrolDescListener:Disconnect() end)
        patrolDescListener = nil
    end
end

local function farmLoop()
    while FarmState.Running do
        waitAlive()
        FarmState.Status = "SCANNING"

        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(1) continue end

        local now = tick()
        for obj, expiry in pairs(FarmState.Blacklist) do
            if expiry <= now then FarmState.Blacklist[obj] = nil end
        end

        local queue = buildItemQueue()

        if #queue == 0 then
            FarmState.Status   = "PATROLLING"
            FarmState.LastItem = "—"
            local wakeUp = false

            patrolActive = true
            patrolDescListener = workspace.DescendantAdded:Connect(function(obj)
                if not patrolActive then return end
                if isWanted(obj.Name) then
                    stopPatrol()
                    wakeUp = true
                end
            end)

            local hum     = char and char:FindFirstChildOfClass("Humanoid")
            local pidx    = 1
            local tStart  = tick()
            while patrolActive and FarmState.Running and tick() - tStart < 30 do
                if hum and Config.PatrolPoints[pidx] then
                    pcall(function() hum:MoveTo(Config.PatrolPoints[pidx]) end)
                    pidx = pidx % #Config.PatrolPoints + 1
                end
                task.wait(1.5)
                if wakeUp then break end
            end
            stopPatrol()
        else
            -- Sort by proximity
            local function sortDist(a, b)
                return (hrp.Position - a.part.Position).Magnitude
                     < (hrp.Position - b.part.Position).Magnitude
            end
            table.sort(queue, sortDist)

            for _, entry in ipairs(queue) do
                if not FarmState.Running then break end
                waitAlive()
                pickupItem(entry)
                task.wait(0.05)
            end
        end
        task.wait(0.3)
    end
    FarmState.Status   = "IDLE"
    FarmState.LastItem = "—"
end

Modules.Farm = {
    Start = function()
        if FarmState.Running then return end
        FarmState.Running = true
        FarmState.Thread  = task.spawn(farmLoop)
    end,
    Stop = function()
        FarmState.Running = false
        stopPatrol()
        if FarmState.Thread then
            pcall(task.cancel, FarmState.Thread)
            FarmState.Thread = nil
        end
    end,
}

