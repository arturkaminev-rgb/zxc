local function findDescendant(root, name)
    for _, v in ipairs(root:GetDescendants()) do
        if v.Name == name then return v end
    end
    return nil
end

-- UTF-8 Cyrillic & Latin lowercase helper for Roblox Luau
local function toLowerUtf8(str)
    if not str or type(str) ~= "string" then return "" end
    str = str:lower()
    local res = {}
    local i = 1
    local len = #str
    while i <= len do
        local b1 = str:byte(i)
        if b1 == 208 then
            local b2 = str:byte(i + 1)
            if b2 and b2 >= 144 and b2 <= 159 then
                -- А - П (0xD0 0x90 .. 0xD0 0x9F) -> а - п (0xD0 0xB0 .. 0xD0 0xBF)
                table.insert(res, string.char(208, b2 + 32))
                i = i + 2
            elseif b2 and b2 >= 160 and b2 <= 175 then
                -- Р - Я (0xD0 0xA0 .. 0xD0 0xAF) -> р - я (0xD1 0x80 .. 0xD1 0x8F)
                table.insert(res, string.char(209, b2 - 32))
                i = i + 2
            elseif b2 == 129 then
                -- Ё (0xD0 0x81) -> ё (0xD1 0x91)
                table.insert(res, string.char(209, 145))
                i = i + 2
            else
                table.insert(res, string.char(b1))
                i = i + 1
            end
        else
            table.insert(res, string.char(b1))
            i = i + 1
        end
    end
    return table.concat(res)
end

local function findDescendantContaining(root, substr)
    local low = toLowerUtf8(substr)
    for _, v in ipairs(root:GetDescendants()) do
        if toLowerUtf8(v.Name):find(low, 1, true) then return v end
        if (v:IsA("TextButton") or v:IsA("TextLabel")) and toLowerUtf8(v.Text):find(low, 1, true) then
            return v
        end
    end
    return nil
end

local function getGuiScreenCenter(guiObj)
    if not guiObj or not guiObj:IsA("GuiObject") then return 0, 0, 0, 0 end
    local absPos = guiObj.AbsolutePosition
    local absSize = guiObj.AbsoluteSize
    local rawX = absPos.X + absSize.X / 2
    local rawY = absPos.Y + absSize.Y / 2

    local guiService = game:GetService("GuiService")
    local inset = guiService and guiService:GetGuiInset() or Vector2.new(0, 0)
    local sg = guiObj:FindFirstAncestorOfClass("ScreenGui")

    local cx = rawX
    local cy = rawY

    -- In Roblox, GuiObject.AbsolutePosition does NOT include the CoreGui topbar inset
    -- unless ScreenGui.IgnoreGuiInset is true. VirtualInputManager expects coordinates
    -- relative to the entire game window, so we must add inset.Y to cy!
    if not sg or not sg.IgnoreGuiInset then
        cy = cy + inset.Y
        cx = cx + inset.X
    end

    return cx, cy, rawX, rawY
end

local function clickWithCursor(guiObj)
    if not guiObj then return false end
    local clicked = false

    local cx, cy, rawX, rawY = getGuiScreenCenter(guiObj)

    -- 1. VirtualInputManager hardware mouse simulation (Hover/Move + Click)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim and cx > 0 and cy > 0 then
            vim:SendMouseMoveEvent(cx, cy, game)
            task.wait(0.02)
            vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.04)
            vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            clicked = true

            -- Backup click at raw coordinates if inset was applied
            if cy ~= rawY then
                task.wait(0.02)
                vim:SendMouseMoveEvent(rawX, rawY, game)
                task.wait(0.01)
                vim:SendMouseButtonEvent(rawX, rawY, 0, true, game, 0)
                task.wait(0.02)
                vim:SendMouseButtonEvent(rawX, rawY, 0, false, game, 0)
            end
        end
    end)

    -- 2. VirtualUser fallback
    pcall(function()
        local vu = game:GetService("VirtualUser")
        if vu and cx > 0 and cy > 0 then
            vu:CaptureController()
            vu:MouseMove(Vector2.new(cx, cy))
            task.wait(0.02)
            vu:Button1Down(Vector2.new(cx, cy))
            task.wait(0.03)
            vu:Button1Up(Vector2.new(cx, cy))
            clicked = true
        end
    end)

    -- 3. firesignal (executors like Synapse, Krnl, Fluxus, Solara, Wave, Delta, etc.)
    if firesignal then
        local targets = { guiObj }
        local cur = guiObj.Parent
        while cur and cur:IsA("GuiObject") and not cur:IsA("ScreenGui") do
            if cur:IsA("GuiButton") then table.insert(targets, cur) end
            cur = cur.Parent
        end
        for _, child in ipairs(guiObj:GetDescendants()) do
            if child:IsA("GuiButton") then
                table.insert(targets, child)
            end
        end

        for _, t in ipairs(targets) do
            pcall(function() firesignal(t.MouseButton1Down) end)
            pcall(function() firesignal(t.MouseButton1Click) end)
            pcall(function() firesignal(t.Activated) end)
            pcall(function() firesignal(t.MouseButton1Up) end)
        end
        clicked = true
    end

    -- 4. Executor FireMouseButton1Click if present
    pcall(function()
        if guiObj.FireMouseButton1Click then
            guiObj:FireMouseButton1Click()
            clicked = true
        end
    end)

    return clicked
end

-- Backward compatibility alias
local clickGuiButton = clickWithCursor

-- Screen click with mouse cursor to use / eat held tools (YBA input mechanic)
local function clickScreenWithCursor()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local cx = vp.X / 2
    local cy = vp.Y / 2

    local vim = game:GetService("VirtualInputManager")
    if vim then
        pcall(function()
            vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.05)
            vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        end)
    end

    local vu = game:GetService("VirtualUser")
    if vu then
        pcall(function()
            vu:CaptureController()
            vu:Button1Down(Vector2.new(cx, cy))
            task.wait(0.05)
            vu:Button1Up(Vector2.new(cx, cy))
        end)
    end

    local char = LocalPlayer.Character
    if char then
        local t = char:FindFirstChildOfClass("Tool")
        if t then pcall(function() t:Activate() end) end
    end
end

local ITEM_GROUPS = {
    arrow = { "mysterious arrow", "таинственная стрела", "таинственн", "стрела", "arrow" },
    lucky = { "lucky arrow", "удачная стрела", "удачлив", "lucky" },
    roka  = { "rokakaka", "рокакака", "чистая рока", "чистая рокакака", "чистая", "рока", "roka" },
    pure  = { "pure rokakaka", "чистая рокакака", "чистая рока" },
    rib   = { "rib cage", "ребро", "труп", "saint's corpse" },
}

local function itemMatches(name, targetKey)
    if not name or not targetKey then return false end
    local n = toLowerUtf8(tostring(name)):gsub("^%s+", ""):gsub("%s+$", "")
    local k = toLowerUtf8(tostring(targetKey)):gsub("^%s+", ""):gsub("%s+$", "")
    if n:find(k, 1, true) or k:find(n, 1, true) then return true end

    for _, group in pairs(ITEM_GROUPS) do
        local nMatch = false
        local kMatch = false
        for _, alias in ipairs(group) do
            if n:find(alias, 1, true) then nMatch = true end
            if k:find(alias, 1, true) then kMatch = true end
        end
        if nMatch and kMatch then return true end
    end
    return false
end

local function countInBackpack(substring)
    local count = 0
    local bp    = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and itemMatches(tool.Name, substring) then
                count += 1
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and itemMatches(tool.Name, substring) then
                count += 1
            end
        end
    end
    local hud = PlayerGui:FindFirstChild("HUD")
    if hud then
        for _, v in ipairs(hud:GetDescendants()) do
            if v:IsA("GuiButton") and v.Visible then
                local txt = v.Text or ""
                local name = v.Name or ""
                if itemMatches(txt, substring) or itemMatches(name, substring) then
                    count += 1
                end
            end
        end
    end
    return count
end

local function waitAlive()
    while true do
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then return end
        end
        task.wait(1)
    end
end

